{
  "displayName": "CloudSmith",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0, "yPos": 0, "width": 12, "height": 2,
        "widget": {
          "title": "How to read this dashboard",
          "text": {
            "format": "MARKDOWN",
            "content": "**Queue or worker?** A growing Pub/Sub backlog with idle workers points at the queue or the agents; full or busy workers point at capacity. **Follow one workspace:** in Logs Explorer, search for its ID (the dashboard URL shows it as `ws-<id>`). The API, agent and proxy all log it as `workspace_id`."
          }
        }
      },
      {
        "xPos": 0, "yPos": 2, "width": 6, "height": 4,
        "widget": {
          "title": "Pub/Sub backlog: jobs waiting per worker",
          "xyChart": {
            "dataSets": [{
              "plotType": "LINE",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"pubsub.googleapis.com/subscription/num_undelivered_messages\" resource.type=\"pubsub_subscription\" resource.label.\"subscription_id\"=starts_with(\"workspace-jobs-worker-\")",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MAX",
                    "crossSeriesReducer": "REDUCE_MAX",
                    "groupByFields": ["resource.label.\"subscription_id\""]
                  }
                }
              }
            }],
            "yAxis": {"label": "jobs", "scale": "LINEAR"}
          }
        }
      },
      {
        "xPos": 6, "yPos": 2, "width": 6, "height": 4,
        "widget": {
          "title": "Pub/Sub: age of the oldest waiting job per worker",
          "xyChart": {
            "dataSets": [{
              "plotType": "LINE",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"pubsub.googleapis.com/subscription/oldest_unacked_message_age\" resource.type=\"pubsub_subscription\" resource.label.\"subscription_id\"=starts_with(\"workspace-jobs-worker-\")",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MAX",
                    "crossSeriesReducer": "REDUCE_MAX",
                    "groupByFields": ["resource.label.\"subscription_id\""]
                  }
                }
              }
            }],
            "yAxis": {"label": "seconds", "scale": "LINEAR"}
          }
        }
      },
      {
        "xPos": 0, "yPos": 6, "width": 6, "height": 4,
        "widget": {
          "title": "Workspaces per worker",
          "xyChart": {
            "dataSets": [{
              "plotType": "LINE",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/cloudsmith_workspaces_per_worker\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_DELTA",
                    "crossSeriesReducer": "REDUCE_MEAN",
                    "groupByFields": ["metric.label.\"worker\""]
                  }
                }
              }
            }],
            "yAxis": {"label": "workspaces", "scale": "LINEAR"}
          }
        }
      },
      {
        "xPos": 6, "yPos": 6, "width": 6, "height": 4,
        "widget": {
          "title": "Failed jobs per minute, by worker",
          "xyChart": {
            "dataSets": [{
              "plotType": "STACKED_BAR",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/cloudsmith_failed_jobs\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_DELTA",
                    "crossSeriesReducer": "REDUCE_SUM",
                    "groupByFields": ["metric.label.\"worker\""]
                  }
                }
              }
            }],
            "yAxis": {"label": "jobs", "scale": "LINEAR"}
          }
        }
      },
      {
        "xPos": 0, "yPos": 10, "width": 6, "height": 4,
        "widget": {
          "title": "Worker VM CPU",
          "xyChart": {
            "dataSets": [{
              "plotType": "LINE",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"compute.googleapis.com/instance/cpu/utilization\" resource.type=\"gce_instance\" metric.label.\"instance_name\"=starts_with(\"cloudsmith-worker-\")",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MEAN",
                    "crossSeriesReducer": "REDUCE_MEAN",
                    "groupByFields": ["metric.label.\"instance_name\""]
                  }
                }
              }
            }],
            "yAxis": {"label": "utilization", "scale": "LINEAR"}
          }
        }
      },
      {
        "xPos": 6, "yPos": 10, "width": 6, "height": 4,
        "widget": {
          "title": "Worker VM memory used",
          "xyChart": {
            "dataSets": [{
              "plotType": "LINE",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"compute.googleapis.com/guest/memory/bytes_used\" resource.type=\"gce_instance\" metric.label.\"state\"=\"used\" metadata.system_labels.\"name\"=starts_with(\"cloudsmith-worker-\")",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MEAN",
                    "crossSeriesReducer": "REDUCE_SUM",
                    "groupByFields": ["metadata.system_labels.\"name\""]
                  }
                }
              }
            }],
            "yAxis": {"label": "bytes", "scale": "LINEAR"}
          }
        }
      },
      {
        "xPos": 0, "yPos": 14, "width": 6, "height": 4,
        "widget": {
          "title": "API requests per second, by response class",
          "xyChart": {
            "dataSets": [{
              "plotType": "STACKED_AREA",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"cloudsmith-api\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_RATE",
                    "crossSeriesReducer": "REDUCE_SUM",
                    "groupByFields": ["metric.label.\"response_code_class\""]
                  }
                }
              }
            }],
            "yAxis": {"label": "requests/s", "scale": "LINEAR"}
          }
        }
      },
      {
        "xPos": 6, "yPos": 14, "width": 6, "height": 4,
        "widget": {
          "title": "API latency (95th percentile)",
          "xyChart": {
            "dataSets": [{
              "plotType": "LINE",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"cloudsmith-api\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_DELTA",
                    "crossSeriesReducer": "REDUCE_PERCENTILE_95"
                  }
                }
              }
            }],
            "yAxis": {"label": "ms", "scale": "LINEAR"}
          }
        }
      },
      {
        "xPos": 0, "yPos": 18, "width": 12, "height": 5,
        "widget": {
          "title": "Warnings and errors (API, agents, proxies)",
          "logsPanel": {
            "filter": "severity>=WARNING AND ((resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"cloudsmith-api\") OR resource.type=\"gce_instance\")"
          }
        }
      }
    ]
  }
}
